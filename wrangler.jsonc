{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpaca-100-paper-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * 1-5"]
  },
  "vars": {
    "TRADING_ENABLED": "false",
    "UNIVERSE": "TQQQ,SQQQ,SOXL,SOXS,TNA,TZA,NVDL,NVDD,TSLL,TSLQ,LABU,LABD",
    "ALLOCATION_PCT": "0.97",
    "STOP_LOSS_PCT": "0.04",
    "TAKE_PROFIT_PCT": "0.06",
    "DAILY_LOSS_LIMIT_PCT": "0.08",
    "MAX_ENTRIES_PER_DAY": "6",
    "REENTRY_COOLDOWN_MINUTES": "10",
    "MIN_RETURN_15M": "0.0015",
    "MIN_RETURN_60M": "0.003",
    "MIN_VOLUME_RATIO": "0.65",
    "REVERSAL_RETURN_15M": "0.0015",
    "ENTRY_START_ET": "09:45",
    "ENTRY_END_ET": "14:30",
    "FORCE_EXIT_ET": "15:50"
  }
}
